# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB={{DB_NAME}}

# Server
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Production Configuration
# ============================================================================

PROD_DOMAIN={{PRODUCTION_DOMAIN}}
PROD_POSTGRES_USER=prod_user
PROD_POSTGRES_PASSWORD=change-this-secure-password
PROD_POSTGRES_DB={{DB_NAME}}_prod

# ============================================================================
# Staging Configuration
# ============================================================================

STAGING_DOMAIN={{STAGING_DOMAIN}}
STAGING_POSTGRES_USER=staging_user
STAGING_POSTGRES_PASSWORD=change-this-secure-password
STAGING_POSTGRES_DB={{DB_NAME}}_staging

# ============================================================================
# Traefik Configuration
# ============================================================================

ACME_EMAIL=admin@example.com
# Generate with: htpasswd -nb admin password | sed 's/\$/\$\$/g'
TRAEFIK_BASIC_AUTH=admin:$$apr1$$xyz...
