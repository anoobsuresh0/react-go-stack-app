# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB={{DB_NAME}}

# Server
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database connection (alternative to individual vars)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{DB_NAME}}?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{DB_NAME}}
DB_SSLMODE=disable

# {{AUTH_BLOCK_START}}
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=change-me-in-production
ALLOWED_EMAIL_DOMAIN=
# {{AUTH_BLOCK_END}}

# {{FULL_DOCKER_BLOCK_START}}
# Staging
STAGING_POSTGRES_USER=postgres
STAGING_POSTGRES_PASSWORD=change-me
STAGING_POSTGRES_DB={{DB_NAME}}_staging

# Production
PROD_POSTGRES_USER=postgres
PROD_POSTGRES_PASSWORD=change-me
PROD_POSTGRES_DB={{DB_NAME}}_production

# Traefik
ACME_EMAIL=admin@example.com
# {{FULL_DOCKER_BLOCK_END}}
