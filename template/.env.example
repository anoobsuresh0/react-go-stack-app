# Server
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
# {{DOCKER_DB_BLOCK_START}}
DB_USER=postgres
DB_PASSWORD=postgres
# {{DOCKER_DB_BLOCK_END}}
# {{LOCAL_DB_BLOCK_START}}
# Leave DB_USER/DB_PASSWORD empty to connect as your current OS user
DB_USER=
DB_PASSWORD=
# {{LOCAL_DB_BLOCK_END}}
DB_NAME={{DB_NAME}}
DB_SSLMODE=disable

# Or override everything with a single connection string:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{DB_NAME}}?sslmode=disable

# Where the built frontend is served from in production (`make build`)
# STATIC_PATH=./web/dist
