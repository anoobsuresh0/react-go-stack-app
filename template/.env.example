# Server
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 18)
# {{DOCKER_DB_BLOCK_START}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{DB_NAME}}?sslmode=disable
# {{DOCKER_DB_BLOCK_END}}
# {{LOCAL_DB_BLOCK_START}}
# Connects as your OS user over localhost; adjust user/password if needed.
DATABASE_URL=postgres://localhost:5432/{{DB_NAME}}?sslmode=disable
# {{LOCAL_DB_BLOCK_END}}

# Where the built frontend is served from in production (`make build`)
# STATIC_PATH=./web/dist
