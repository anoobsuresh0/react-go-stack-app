{
  "name": "@anoobsuresh0/react-go-stack-app",
  "version": "3.0.0",
  "description": "CLI to scaffold production-ready full-stack apps with Go (Gin), React (Vite + TypeScript + Tailwind, optional shadcn/ui), and PostgreSQL 18 (Docker or local)",
  "type": "module",
  "bin": {
    "react-go-stack-app": "./bin/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node bin/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "react",
    "golang",
    "go",
    "postgresql",
    "docker",
    "fullstack",
    "starter",
    "template",
    "scaffold"
  ],
  "author": "Anoob Suresh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anoobsuresh0/react-go-stack-app.git"
  },
  "homepage": "https://github.com/anoobsuresh0/react-go-stack-app#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "validate-npm-package-name": "^5.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.2",
    "@types/validate-npm-package-name": "^4.0.2",
    "typescript": "^5.9.3"
  }
}
